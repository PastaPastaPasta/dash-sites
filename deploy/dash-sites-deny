#!/usr/bin/env node
// Operator denylist for a hosted Dash Sites gateway. Installed by deploy.sh as /usr/local/bin/dash-sites-deny.
//   dash-sites-deny list
//   dash-sites-deny add name <label>|owner <identity id>|content <content URI> [note]
//   dash-sites-deny remove name|owner|content <value>
//   dash-sites-deny apply
// The list lives in DENYLIST_FILE (gateway.env). Every change rewrites it, then publishes it in three places:
// the gateway process reloads the file itself within seconds; browsers' verifiers read
// /etc/dash-sites/public/denylist.json within a minute; refused names lose the shell entirely through
// /etc/dash-sites/denied.caddy, which Caddy reloads here.
import { execFileSync } from 'node:child_process';
import { mkdirSync, readFileSync, renameSync, statSync, writeFileSync } from 'node:fs';

const ENV_FILE = process.env.GATEWAY_ENV ?? '/etc/dash-sites/gateway.env';
const ROOT = process.env.DASH_SITES_ROOT ?? '';
const CADDY_FILE = `${ROOT}/etc/dash-sites/denied.caddy`;
const PUBLIC_DIR = `${ROOT}/etc/dash-sites/public`;
const SHELL_DIR = '/opt/dash-sites/shell';
const KINDS = ['name', 'owner', 'content'];

const fail = (message) => {
  console.error(`dash-sites-deny: ${message}`);
  process.exit(1);
};

const [command, kind, rawValue, ...note] = process.argv.slice(2);
if (!['list', 'apply', 'add', 'remove'].includes(command)) {
  console.log(readFileSync(new URL(import.meta.url), 'utf8').split('\n').slice(1, 6).join('\n').replace(/^\/\/ ?/gm, ''));
  process.exit(command ? 1 : 0);
}

const env = Object.fromEntries(
  readFileSync(ENV_FILE, 'utf8')
    .split('\n')
    .map((line) => /^\s*([A-Z_]+)=(.*)$/.exec(line.replace(/\s+#.*$/, '')))
    .filter(Boolean)
    .map((match) => [match[1], match[2].trim().replace(/^"(.*)"$/, '$1')]),
);
const LIST_FILE = env.DENYLIST_FILE || fail(`DENYLIST_FILE is not set in ${ENV_FILE}: this gateway has no denylist`);
const domains = (env.GATEWAY_DOMAINS ?? '').split(',').map((entry) => entry.trim().replace(/^https?:\/\//, '').replace(/[:/].*$/, '').toLowerCase()).filter(Boolean);

// DPNS normal form: lowercase, o to 0, i and l to 1. Look-alike spellings are one name.
const label = (value) => value.trim().toLowerCase().replace(/\.dash\.?$/, '').replace(/o/g, '0').replace(/[il]/g, '1');
const canonical = (kind, value) => (kind === 'name' ? label(value) : value.trim());
const validate = (kind, value) => {
  if (!KINDS.includes(kind)) fail(`kind must be one of ${KINDS.join(', ')}`);
  if (!value) fail(`missing ${kind}`);
  if (kind === 'name' && !(/^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$/.test(value) && value.slice(2, 4) !== '--')) fail(`"${value}" is not a DPNS label`);
  if (kind === 'owner' && !/^[1-9A-HJ-NP-Za-km-z]{42,46}$/.test(value)) fail(`"${value}" is not an identity id`);
  if (/[\s#]/.test(value)) fail('values cannot contain spaces or #');
};

function readLines() {
  try {
    return readFileSync(LIST_FILE, 'utf8').split('\n');
  } catch {
    return ['# name <label> | owner <identity id> | content <content URI>'];
  }
}

function entries(lines) {
  const out = [];
  for (const raw of lines) {
    const line = raw.replace(/#.*/, '').trim();
    if (!line) continue;
    const [kind, value] = line.split(/\s+/, 2);
    if (!KINDS.includes(kind) || !value) fail(`${LIST_FILE}: cannot read "${raw}"`);
    validate(kind, canonical(kind, value));
    out.push({ kind, value: canonical(kind, value), raw });
  }
  return out;
}

const atomicWrite = (file, text) => {
  let mode = 0o644;
  try {
    mode = statSync(file).mode & 0o777;
  } catch {}
  const tmp = `${file}.${process.pid}.tmp`;
  writeFileSync(tmp, text, { mode });
  renameSync(tmp, file);
};

const escapeRegex = (text) => text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const spellings = (name) => [...name].map((c) => (c === '0' ? '[o0]' : c === '1' ? '[il1]' : escapeRegex(c))).join('');

function caddyBlock(names) {
  if (names.length === 0 || domains.length === 0) return '# Written by dash-sites-deny. No name is refused.\n';
  const pattern = `^(?i)(${names.map(spellings).join('|')})\\.(${domains.map(escapeRegex).join('|')})(:[0-9]+)?$`;
  return `# Written by dash-sites-deny from ${LIST_FILE}; edit with dash-sites-deny, not by hand.
# Refused names, in every DPNS look-alike spelling, get no shell: the notice page, and a worker that
# removes an installed shell.
@denied header_regexp Host ${pattern}
handle @denied {
\t@worker path /sw.js
\thandle @worker {
\t\troot * ${SHELL_DIR}
\t\trewrite * /denied-sw.js
\t\theader Cache-Control "no-cache"
\t\tfile_server
\t}
\thandle {
\t\troot * ${SHELL_DIR}
\t\trewrite * /unavailable.html
\t\theader Cache-Control "no-store"
\t\theader X-Content-Type-Options nosniff
\t\tfile_server {
\t\t\tstatus 451
\t\t}
\t}
}
`;
}

function apply(list) {
  const pick = (kind) => [...new Set(list.filter((entry) => entry.kind === kind).map((entry) => entry.value))].sort();
  mkdirSync(PUBLIC_DIR, { recursive: true, mode: 0o755 });
  atomicWrite(`${PUBLIC_DIR}/denylist.json`, `${JSON.stringify({ names: pick('name'), owners: pick('owner'), content: pick('content') })}\n`);
  let previous = '';
  try {
    previous = readFileSync(CADDY_FILE, 'utf8');
  } catch {}
  const next = caddyBlock(pick('name'));
  if (next !== previous) {
    atomicWrite(CADDY_FILE, next);
    try {
      execFileSync('caddy', ['validate', '--adapter', 'caddyfile', '--config', '/etc/caddy/Caddyfile'], { stdio: 'pipe' });
    } catch (error) {
      atomicWrite(CADDY_FILE, previous);
      fail(`Caddy rejected the new host rules, so Caddy keeps the old ones. The gateway and browsers already use the new list.\n${error.stderr ?? error}`);
    }
    try {
      execFileSync('systemctl', ['reload', 'caddy'], { stdio: 'pipe' });
    } catch (error) {
      fail(`systemctl reload caddy failed; ${CADDY_FILE} is written and applies on the next reload.\n${error.stderr ?? error}`);
    }
  }
  console.log(`denylist: ${pick('name').length} names, ${pick('owner').length} owners, ${pick('content').length} contents`);
}

const lines = readLines();
const list = entries(lines);
if (command === 'list') {
  for (const entry of list) console.log(entry.raw.trim());
} else if (command === 'apply') {
  apply(list);
} else if (command === 'add' || command === 'remove') {
  const value = canonical(kind ?? '', rawValue ?? '');
  validate(kind, value);
  const present = list.some((entry) => entry.kind === kind && entry.value === value);
  if (command === 'add') {
    if (present) console.log(`${kind} ${value} is already refused`);
    else {
      const comment = [new Date().toISOString().slice(0, 10), ...note].join(' ').replace(/\n/g, ' ');
      const written = kind === 'name' ? rawValue.trim().toLowerCase().replace(/\.dash\.?$/, '') : value;
      lines.splice(lines.length && lines.at(-1) === '' ? lines.length - 1 : lines.length, 0, `${kind} ${written}  # ${comment}`);
      atomicWrite(LIST_FILE, `${lines.join('\n').replace(/\n*$/, '')}\n`);
    }
  } else {
    if (!present) fail(`${kind} ${value} is not in the list`);
    if (kind === 'name') console.log(`removing every spelling of ${value}`);
    const kept = lines.filter((raw) => {
      const [k, v] = raw.replace(/#.*/, '').trim().split(/\s+/, 2);
      return !(k === kind && v && canonical(k, v) === value);
    });
    atomicWrite(LIST_FILE, `${kept.join('\n').replace(/\n*$/, '')}\n`);
  }
  apply(entries(readLines()));
}

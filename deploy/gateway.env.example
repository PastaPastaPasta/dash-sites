# /etc/dash-sites/gateway.env
GATEWAY_DOMAINS=id.dashhq.org
NETWORK=testnet
# CONTRACT_ID=            # only to override the contract id built into the release
PORT=8080
HOST=127.0.0.1
TRUST_PROXY=1
BUILDER_URL=https://dash-sites.thepasta.org/
EXTENSION_URL=https://github.com/PastaPastaPasta/dash-sites/releases/latest
ABUSE_CONTACT=https://github.com/PastaPastaPasta/dash-sites/issues
DENYLIST_FILE=/etc/dash-sites/denylist.txt
RESERVED_LABELS=www
MAX_SITE_BYTES=26214400
RATE_LIMIT_PER_MINUTE=600
CHUNK_CACHE_MB=96
LOG_REQUESTS=0

{
  "site": {
    "type": "object",
    "documentsMutable": true,
    "canBeDeleted": false,
    "immutable": [
      "normalizedParentDomainName",
      "normalizedLabel"
    ],
    "properties": {
      "normalizedParentDomainName": {
        "type": "string",
        "pattern": "^[a-hj-km-np-z0-9][a-hj-km-np-z0-9-\\.]{0,61}[a-hj-km-np-z0-9]$",
        "minLength": 2,
        "maxLength": 63,
        "position": 0,
        "description": "normalizedParentDomainName of the DPNS domain the site is published under: dash"
      },
      "normalizedLabel": {
        "type": "string",
        "pattern": "^[a-hj-km-np-z0-9][a-hj-km-np-z0-9-]{0,61}[a-hj-km-np-z0-9]$",
        "minLength": 3,
        "maxLength": 63,
        "position": 1,
        "description": "normalizedLabel of that DPNS domain, e.g. a11ce. Anyone can write a record for a name; readers take only the record of the identity that owns the domain."
      },
      "content": {
        "type": "string",
        "pattern": "^[\\x21-\\x7e]+$",
        "minLength": 1,
        "maxLength": 2048,
        "position": 2,
        "description": "Content URI: dash-manifest:v1:<hex>[,<hex>...] or ipfs://<cid>. A record without one says the name has no site."
      },
      "v": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535,
        "position": 3,
        "description": "Format version of this site record. A reader refuses a version newer than it reads, rather than misreading it. docs/VERSIONING.md lists the versions."
      }
    },
    "indices": [
      {
        "name": "nameAndOwner",
        "properties": [
          {
            "normalizedParentDomainName": "asc"
          },
          {
            "normalizedLabel": "asc"
          },
          {
            "$ownerId": "asc"
          }
        ],
        "unique": true
      },
      {
        "name": "ownerAndName",
        "properties": [
          {
            "$ownerId": "asc"
          },
          {
            "normalizedParentDomainName": "asc"
          },
          {
            "normalizedLabel": "asc"
          }
        ],
        "unique": true
      },
      {
        "name": "updated",
        "properties": [
          {
            "$updatedAt": "asc"
          }
        ],
        "countable": "countable",
        "rangeCountable": true
      }
    ],
    "required": [
      "normalizedParentDomainName",
      "normalizedLabel",
      "v",
      "$createdAt",
      "$updatedAt"
    ],
    "additionalProperties": false,
    "transferable": 0,
    "tradeMode": 0
  },
  "chunk": {
    "type": "object",
    "documentsMutable": false,
    "canBeDeleted": true,
    "properties": {
      "site": {
        "type": "array",
        "byteArray": true,
        "minItems": 32,
        "maxItems": 32,
        "position": 0,
        "contentMediaType": "application/x.dash.dpp.identifier",
        "description": "$id of the site record the chunk belongs to. Platform accepts a chunk only from the identity that wrote that record.",
        "refersTo": {
          "type": "permanentDocument",
          "documentType": "site",
          "where": {
            "$ownerId": "$ownerId"
          }
        }
      },
      "hash": {
        "type": "array",
        "byteArray": true,
        "minItems": 32,
        "maxItems": 32,
        "position": 1,
        "contentMediaType": "application/x.dash.dpp.identifier",
        "description": "sha256 of d0 || d1 || d2. Typed as an identifier so that queries take it in base58."
      },
      "d0": {
        "type": "array",
        "byteArray": true,
        "minItems": 1,
        "maxItems": 4900,
        "position": 2
      },
      "d1": {
        "type": "array",
        "byteArray": true,
        "minItems": 1,
        "maxItems": 4900,
        "position": 3
      },
      "d2": {
        "type": "array",
        "byteArray": true,
        "minItems": 1,
        "maxItems": 4900,
        "position": 4
      },
      "v": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535,
        "position": 5,
        "description": "Format version of this chunk. A reader refuses a version newer than it reads, rather than misreading it. docs/VERSIONING.md lists the versions."
      }
    },
    "indices": [
      {
        "name": "siteAndHash",
        "properties": [
          {
            "site": "asc"
          },
          {
            "hash": "asc"
          }
        ],
        "unique": true
      }
    ],
    "required": [
      "site",
      "hash",
      "d0",
      "v",
      "$createdAt"
    ],
    "additionalProperties": false,
    "transferable": 0,
    "tradeMode": 0
  }
}

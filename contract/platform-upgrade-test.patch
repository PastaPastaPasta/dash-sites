+    // The dash-sites contract (https://github.com/PastaPastaPasta/dash-sites), registered under
+    // protocol version 14 and written to on both sides of the upgrade to protocol version 15.
+    // Run with DASH_SITES_SCHEMA=<path to contract/dash-sites.v2.json> and RUST_MIN_STACK=268435456.
+
+    /// The contract a registration of the schema file would store, fully validated.
+    fn sites_contract(
+        platform_version: &PlatformVersion,
+    ) -> Result<DataContract, dpp::ProtocolError> {
+        let schema_path = std::env::var("DASH_SITES_SCHEMA")
+            .expect("set DASH_SITES_SCHEMA to the path of contract/dash-sites.v2.json");
+        let schemas: serde_json::Value = serde_json::from_str(
+            &std::fs::read_to_string(schema_path).expect("expected to read the schema file"),
+        )
+        .expect("expected the schema file to be JSON");
+        let contract = serde_json::json!({
+            "$formatVersion": "1",
+            "id": "CjzpdgCPJdLgVZdUu8SNacWVnrhDv34LstjPdBeJ4dT",
+            "ownerId": "AkhihKhRLGjKB1WTdUG7BWrGnTaTTHcMzdSBsKSJ5GNm",
+            "version": 1,
+            "documentSchemas": schemas,
+        });
+        let path = std::env::temp_dir().join(format!(
+            "dash-sites-contract-{}-{}.json",
+            std::process::id(),
+            platform_version.protocol_version
+        ));
+        std::fs::write(&path, contract.to_string()).expect("expected to write the contract");
+        let result = json_document_to_contract(&path, true, platform_version);
+        let _ = std::fs::remove_file(&path);
+        result
+    }
+
+    fn text(value: &str) -> Value {
+        Value::Text(value.to_string())
+    }
+
+    fn accepted(result: &StateTransitionExecutionResult) -> bool {
+        matches!(
+            result,
+            StateTransitionExecutionResult::SuccessfulExecution { .. }
+        )
+    }
+
+    fn outcome(result: &StateTransitionExecutionResult) -> String {
+        match result {
+            StateTransitionExecutionResult::SuccessfulExecution { .. } => "ACCEPTED".to_string(),
+            StateTransitionExecutionResult::PaidConsensusError { error, .. } => {
+                format!("REFUSED ({}) {}", error.code(), error)
+            }
+            other => format!("OTHER {:?}", other),
+        }
+    }
+
+    impl DpnsFixture {
+        fn apply_sites(&self) -> Identifier {
+            let mut contract = sites_contract(self.platform_version)
+                .expect("expected the dash-sites contract to pass full validation");
+            contract.set_owner_id(self.id(Who::Alice));
+            self.platform
+                .drive
+                .apply_contract(
+                    &contract,
+                    block(REVEAL_HEIGHT + 1),
+                    true,
+                    StorageFlags::optional_default_as_cow(),
+                    None,
+                    self.platform_version,
+                )
+                .expect("expected to apply the dash-sites contract");
+            contract.id()
+        }
+
+        /// The contract as stored, read at the fixture's current protocol version.
+        fn stored(&self, id: Identifier) -> DataContract {
+            self.platform
+                .drive
+                .get_contract_with_fetch_info(id.to_buffer(), false, None, self.platform_version)
+                .expect("expected to fetch the contract")
+                .expect("expected the contract in state")
+                .contract
+                .clone()
+        }
+
+        async fn sites_create(
+            &mut self,
+            contract_id: Identifier,
+            who: Who,
+            nonce: &mut IdentityNonce,
+            type_name: &str,
+            values: &[(&str, Value)],
+            height: u64,
+        ) -> (Document, StateTransitionExecutionResult) {
+            let platform_version = self.platform_version;
+            let owner_id = self.id(who);
+            let contract = self.stored(contract_id);
+            let document_type = contract
+                .document_type_for_name(type_name)
+                .expect("expected the document type");
+            let entropy = Bytes32::random_with_rng(&mut self.rng);
+            let mut document = document_type
+                .random_document_with_identifier_and_entropy(
+                    &mut self.rng,
+                    owner_id,
+                    entropy,
+                    DocumentFieldFillType::DoNotFillIfNotRequired,
+                    DocumentFieldFillSize::AnyDocumentFillSize,
+                    platform_version,
+                )
+                .expect("expected a random document");
+            for (property, value) in values {
+                document.set(property, value.clone());
+            }
+            *nonce += 1;
+            document
+                .set_id_for_creation(document_type, &entropy.0, *nonce, platform_version)
+                .expect("expected to set the document id");
+            let writer = self.writer(who);
+            let mut transition = BatchTransition::new_document_creation_transition_from_document(
+                document.clone(),
+                document_type,
+                entropy.0,
+                &writer.key,
+                *nonce,
+                0,
+                None,
+                &writer.signer,
+                platform_version,
+                None,
+            )
+            .await
+            .expect("expected the create transition");
+            {
+                let StateTransition::Batch(batch) = &mut transition else {
+                    panic!("expected a batch transition");
+                };
+                let Some(BatchedTransitionMutRef::Document(document_transition)) =
+                    batch.first_transition_mut()
+                else {
+                    panic!("expected a document transition");
+                };
+                *document_transition
+                    .data_mut()
+                    .expect("the document transition carries data") = document.properties().clone();
+            }
+            transition
+                .sign_external(
+                    &writer.key,
+                    &writer.signer,
+                    Some(|_, _| Ok(SecurityLevel::HIGH)),
+                )
+                .await
+                .expect("expected to sign the transition again");
+            let result = self.process(&transition, height);
+            (document, result)
+        }
+
+        /// Replaces `document`, as it now stands, at the next revision. A refused replace
+        /// leaves the revision where it was.
+        async fn sites_replace(
+            &mut self,
+            contract_id: Identifier,
+            who: Who,
+            nonce: &mut IdentityNonce,
+            type_name: &str,
+            document: &mut Document,
+            height: u64,
+        ) -> StateTransitionExecutionResult {
+            let platform_version = self.platform_version;
+            let contract = self.stored(contract_id);
+            let document_type = contract
+                .document_type_for_name(type_name)
+                .expect("expected the document type");
+            let revision = document.revision().unwrap_or(1);
+            document.set_revision(Some(revision + 1));
+            *nonce += 1;
+            let writer = self.writer(who);
+            let transition = BatchTransition::new_document_replacement_transition_from_document(
+                document.clone(),
+                document_type,
+                &writer.key,
+                *nonce,
+                0,
+                None,
+                &writer.signer,
+                platform_version,
+                None,
+            )
+            .await
+            .expect("expected the replace transition");
+            let result = self.process(&transition, height);
+            if !accepted(&result) {
+                document.set_revision(Some(revision));
+            }
+            result
+        }
+
+        async fn sites_delete(
+            &mut self,
+            contract_id: Identifier,
+            who: Who,
+            nonce: &mut IdentityNonce,
+            type_name: &str,
+            document: &Document,
+            height: u64,
+        ) -> StateTransitionExecutionResult {
+            let platform_version = self.platform_version;
+            let contract = self.stored(contract_id);
+            let document_type = contract
+                .document_type_for_name(type_name)
+                .expect("expected the document type");
+            *nonce += 1;
+            let writer = self.writer(who);
+            match BatchTransition::new_document_deletion_transition_from_document(
+                document.clone(),
+                document_type,
+                &writer.key,
+                *nonce,
+                0,
+                None,
+                &writer.signer,
+                platform_version,
+                None,
+            )
+            .await
+            {
+                Ok(transition) => self.process(&transition, height),
+                Err(error) => panic!("DELETE NOT BUILT: {error}"),
+            }
+        }
+    }
+
+    /// Every kind of write the contract takes or refuses, on both sides of the upgrade.
+    #[tokio::test]
+    async fn dash_sites_contract_across_the_upgrade() {
+        let mut fixture = DpnsFixture::new(14);
+        let sites = fixture.apply_sites();
+        let (mut alice, mut bob) = (0, 0);
+        let name = |label: &str| {
+            [
+                ("normalizedParentDomainName", text("dash")),
+                ("normalizedLabel", text(label)),
+            ]
+        };
+        let record = name("quantum7");
+        let mut log = Vec::new();
+        let mut step = |what: &str, result: &StateTransitionExecutionResult, expected: bool| {
+            println!("{what}: {}", outcome(result));
+            log.push((what.to_string(), accepted(result) == expected));
+        };
+
+        for (who, label, height) in [
+            (Who::Alice, "quantum7", 13),
+            (Who::Alice, "quantum8", 15),
+            (Who::Bob, "quantum9", 17),
+        ] {
+            let (_, result) = fixture.register_at(who, label, height).await;
+            step(&format!("PV14 register {label}.dash"), &result, true);
+        }
+
+        let (mut site, result) = fixture
+            .sites_create(sites, Who::Alice, &mut alice, "site", &record, 20)
+            .await;
+        step("PV14 create a site record", &result, true);
+        let chunk_of = |site: &Document| [("site", Value::Identifier(site.id().to_buffer()))];
+        let (_, result) = fixture
+            .sites_create(sites, Who::Alice, &mut alice, "chunk", &chunk_of(&site), 21)
+            .await;
+        step("PV14 store a chunk under the own record", &result, true);
+        let (_, result) = fixture
+            .sites_create(sites, Who::Bob, &mut bob, "chunk", &chunk_of(&site), 22)
+            .await;
+        step("PV14 store a chunk under another identity's record", &result, false);
+        let (_, result) = fixture
+            .sites_create(sites, Who::Alice, &mut alice, "site", &record, 23)
+            .await;
+        step("PV14 create a second record for the same name", &result, false);
+        let (_, result) = fixture
+            .sites_create(sites, Who::Bob, &mut bob, "site", &record, 24)
+            .await;
+        step("PV14 create a record for a name another identity owns", &result, false);
+        let (_, result) = fixture
+            .sites_create(sites, Who::Alice, &mut alice, "site", &name("quantum6"), 25)
+            .await;
+        step("PV14 create a record for a name nobody registered", &result, false);
+        let (bob_site, result) = fixture
+            .sites_create(sites, Who::Bob, &mut bob, "site", &name("quantum9"), 26)
+            .await;
+        step("PV14 another identity creates a record for its own name", &result, true);
+        let mut moved = site.clone();
+        moved.set("normalizedLabel", text("quantum9"));
+        let result = fixture
+            .sites_replace(sites, Who::Alice, &mut alice, "site", &mut moved, 27)
+            .await;
+        step("PV14 move a record to a name another identity owns", &result, false);
+
+        fixture.activate_protocol_version_15(30);
+
+        site.set("content", text("dash-manifest:v1:00"));
+        let result = fixture
+            .sites_replace(sites, Who::Alice, &mut alice, "site", &mut site, 31)
+            .await;
+        step("PV15 replace the record with content", &result, true);
+        site.remove("content");
+        let result = fixture
+            .sites_replace(sites, Who::Alice, &mut alice, "site", &mut site, 32)
+            .await;
+        step("PV15 replace the record without content", &result, true);
+        let (chunk, result) = fixture
+            .sites_create(sites, Who::Alice, &mut alice, "chunk", &chunk_of(&site), 33)
+            .await;
+        step("PV15 store a chunk under the own record", &result, true);
+        let (_, result) = fixture
+            .sites_create(sites, Who::Bob, &mut bob, "chunk", &chunk_of(&site), 34)
+            .await;
+        step("PV15 store a chunk under another identity's record", &result, false);
+        let (_, result) = fixture
+            .sites_create(sites, Who::Bob, &mut bob, "chunk", &chunk_of(&bob_site), 35)
+            .await;
+        step("PV15 the other identity stores a chunk under its own record", &result, true);
+        let mut other = name("quantum8").to_vec();
+        other.push(("content", text("ipfs://bafy")));
+        let (_, result) = fixture
+            .sites_create(sites, Who::Alice, &mut alice, "site", &other, 36)
+            .await;
+        step("PV15 create a record for another own name", &result, true);
+        let (_, result) = fixture
+            .sites_create(sites, Who::Alice, &mut alice, "site", &record, 37)
+            .await;
+        step("PV15 create a second record for the same name", &result, false);
+        let (_, result) = fixture
+            .sites_create(sites, Who::Bob, &mut bob, "site", &record, 38)
+            .await;
+        step("PV15 create a record for a name another identity owns", &result, false);
+        let result = fixture
+            .sites_delete(sites, Who::Alice, &mut alice, "chunk", &chunk, 39)
+            .await;
+        step("PV15 delete a chunk", &result, true);
+        let result = fixture
+            .sites_delete(sites, Who::Alice, &mut alice, "site", &site, 40)
+            .await;
+        step("PV15 delete a site record", &result, false);
+        let mut moved = site.clone();
+        moved.set("normalizedLabel", text("quantum6"));
+        let result = fixture
+            .sites_replace(sites, Who::Alice, &mut alice, "site", &mut moved, 41)
+            .await;
+        step("PV15 move a record to a name nobody registered", &result, false);
+        let mut moved = site.clone();
+        moved.set("normalizedParentDomainName", text("d4sh"));
+        let result = fixture
+            .sites_replace(sites, Who::Alice, &mut alice, "site", &mut moved, 41)
+            .await;
+        step("PV15 move a record to another parent domain", &result, false);
+
+        let bob_id = fixture.id(Who::Bob);
+        let quantum7 = fixture.name("quantum7").expect("expected quantum7.dash");
+        let revision = quantum7.revision().unwrap_or(1);
+        let result = fixture
+            .transfer(Who::Alice, &quantum7, revision, bob_id, 42)
+            .await;
+        step("PV15 transfer quantum7.dash to the other identity", &result, true);
+        site.set("content", text("ipfs://bafysold"));
+        let result = fixture
+            .sites_replace(sites, Who::Alice, &mut alice, "site", &mut site, 43)
+            .await;
+        step("PV15 the previous owner replaces its record after the name changed hands", &result, false);
+        let (_, result) = fixture
+            .sites_create(sites, Who::Bob, &mut bob, "site", &record, 44)
+            .await;
+        step("PV15 the new owner creates its record for the name", &result, true);
+
+        let quantum9 = fixture.name("quantum9").expect("expected quantum9.dash");
+        let result = fixture.delete(Who::Bob, "domain", &quantum9, 45).await;
+        step("PV15 delete quantum9.dash", &result, true);
+        let mut bob_site = bob_site;
+        bob_site.set("content", text("ipfs://bafygone"));
+        let result = fixture
+            .sites_replace(sites, Who::Bob, &mut bob, "site", &mut bob_site, 46)
+            .await;
+        step("PV15 replace a record whose name was deleted", &result, false);
+        let (_, result) = fixture
+            .sites_create(sites, Who::Alice, &mut alice, "site", &name("quantum9"), 47)
+            .await;
+        step("PV15 create a record for a deleted name", &result, false);
+
+        let wrong: Vec<_> = log.iter().filter(|(_, ok)| !ok).map(|(what, _)| what).collect();
+        assert!(wrong.is_empty(), "unexpected outcomes: {wrong:?}");
+    }
+
+    /// The schema as a registration under each protocol version would check it.
+    #[test]
+    fn dash_sites_contract_under_full_validation() {
+        for protocol_version in [14, 15] {
+            let platform_version = PlatformVersion::get(protocol_version).unwrap();
+            let result = sites_contract(platform_version);
+            println!(
+                "PV{protocol_version} full validation: {}",
+                match &result {
+                    Ok(_) => "VALID".to_string(),
+                    Err(error) => format!("INVALID {error}"),
+                }
+            );
+            assert!(result.is_ok());
+        }
+    }
